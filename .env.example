# Server-only Supabase credentials (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret passcode to unlock the capsule
CAPSULE_PASSCODE=change-me-to-our-secret

# 32+ byte random string used to sign HttpOnly HMAC-SHA256 session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-64-char-hex-secret
